From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Marius DKM <mariusdkm@gmail.com>
Date: Mon, 2 Nov 2026 17:25:25 +0100
Subject: [PATCH 1/2] Add timing headers to the pipe backend

With timing_headers = "yes" in the pipe section, every block of audio is preceded by a
32-byte header giving its RTP timestamp and the CLOCK_MONOTONIC_RAW time in ns at which its
first frame should be played, plus header-only records on flush and stop. This lets a reader
that schedules the audio itself play it in sync with the sender's other AirPlay receivers.
The layout is documented in audio_pipe.c.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 audio_pipe.c                | 205 ++++++++++++++++++++++++++++++++----
 scripts/shairport-sync.conf |   1 +
 2 files changed, 187 insertions(+), 19 deletions(-)

diff --git a/audio_pipe.c b/audio_pipe.c
index c776305..1474f36 100644
--- a/audio_pipe.c
+++ b/audio_pipe.c
@@ -33,6 +33,8 @@
 #include <errno.h>
 #include <fcntl.h>
 #include <memory.h>
+#include <pthread.h>
+#include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <sys/stat.h>
@@ -44,6 +46,28 @@
 static int fd = -1;
 static int warned = 0;
 static unsigned int bytes_per_frame = 0;
+static unsigned int output_rate = 0;
+
+// Optional record framing: a 32-byte little-endian header before every payload, so the reader
+// knows when each frame should be played. Without a delay() method the player hands over every
+// buffer contiguously from its playtime, so a record's frames follow on from its should_be time.
+#define TIMING_HEADER_MAGIC 0x48545053 // "SPTH"
+#define TIMING_HEADER_VERSION 1
+#define TIMING_HEADER_SIZE 32
+enum { TIMING_FLAG_TIMED = 1, TIMING_FLAG_FLUSH = 2, TIMING_FLAG_STOP = 4 };
+
+static int timing_headers = 0;
+static uint8_t *record_buf = NULL;
+static size_t record_buf_size = 0;
+// Held while a record is written, so records never interleave. With timing headers on, fd is
+// only opened, written and closed with it held.
+static pthread_mutex_t record_lock = PTHREAD_MUTEX_INITIALIZER;
+// Flush and stop markers not written yet. flush() is called with the player's flush_mutex held,
+// possibly from another thread, so it never waits for record_lock or a full pipe: a marker it
+// can't write at once is written before the next record instead. Only held briefly, never
+// across a write.
+static pthread_mutex_t pending_lock = PTHREAD_MUTEX_INITIALIZER;
+static uint16_t pending_markers = 0;

 char *pipename = NULL;
 char *default_pipe_name = "/tmp/shairport-sync-audio";
@@ -71,33 +95,168 @@ static int prepare() {
   return result;
 }

-static int play(void *buf, int samples, __attribute__((unused)) int sample_type,
-                __attribute__((unused)) uint32_t timestamp,
-                __attribute__((unused)) uint64_t playtime) {
-  // if the file is not open, try to open it.
-  char errorstring[1024];
-  if (fd == -1) {
-    fd = try_to_open_pipe_for_writing(pipename);
+static void put_le(uint8_t *p, uint64_t v, int bytes) {
+  for (int i = 0; i < bytes; i++)
+    p[i] = (v >> (8 * i)) & 0xFF;
+}
+
+static void put_header(uint8_t *p, uint16_t flags, int frames, uint32_t timestamp,
+                       uint64_t playtime) {
+  put_le(p + 0, TIMING_HEADER_MAGIC, 4);
+  put_le(p + 4, TIMING_HEADER_VERSION, 2);
+  put_le(p + 6, flags, 2);
+  put_le(p + 8, frames, 4);
+  put_le(p + 12, timestamp, 4);
+  put_le(p + 16, playtime, 8);
+  put_le(p + 24, output_rate, 4);
+  put_le(p + 28, bytes_per_frame, 4);
+}
+
+// Call with record_lock held. A record that fails part way is not finished later: the pipe is
+// closed instead, and reopened by the next play(). If the reader has gone (EPIPE), nothing has
+// the pipe open any more and the kernel drops what is left in it, so the next reader starts at
+// a record boundary. A reader that stays attached through some other error has to find the next
+// record by its magic.
+static int write_fully(const uint8_t *buf, size_t size) {
+  for (size_t done = 0; done < size;) {
+    ssize_t n = write(fd, buf + done, size - done);
+    if (n < 0) {
+      if (errno == EINTR)
+        continue;
+      int write_errno = errno;
+      safe_socket_close(&fd);
+      errno = write_errno;
+      return -1;
+    }
+    done += n;
   }
-  // if it's got a reader, write to it.
+  return size;
+}
+
+// Call with record_lock held. Writes the pending markers as one header-only record. With
+// nonblocking set, a full pipe leaves them pending.
+static void write_pending_markers(int nonblocking) {
+  pthread_mutex_lock(&pending_lock);
+  uint16_t flags = pending_markers;
+  pthread_mutex_unlock(&pending_lock);
+  if (flags == 0)
+    return;
+  if (fd > 0) { // without a reader, there is nothing to mark
+    uint8_t header[TIMING_HEADER_SIZE];
+    put_header(header, flags, 0, 0, 0);
+    if (nonblocking) {
+      // A pipe write of up to PIPE_BUF bytes is atomic: all of the header or EAGAIN.
+      int fd_flags = fcntl(fd, F_GETFL);
+      if ((fd_flags == -1) || (fcntl(fd, F_SETFL, fd_flags | O_NONBLOCK) == -1))
+        return;
+      ssize_t n;
+      do {
+        n = write(fd, header, sizeof(header));
+      } while ((n < 0) && (errno == EINTR));
+      int write_errno = errno;
+      fcntl(fd, F_SETFL, fd_flags);
+      if ((n < 0) && ((write_errno == EAGAIN) || (write_errno == EWOULDBLOCK)))
+        return; // the pipe is full
+      if (n < 0)
+        safe_socket_close(&fd);
+    } else {
+      write_fully(header, sizeof(header));
+    }
+  }
+  pthread_mutex_lock(&pending_lock);
+  pending_markers &= ~flags;
+  pthread_mutex_unlock(&pending_lock);
+}
+
+static int write_record(const void *payload, int frames, int sample_type, uint32_t timestamp,
+                        uint64_t playtime) {
+  size_t payload_size = (size_t)frames * bytes_per_frame;
+  size_t size = TIMING_HEADER_SIZE + payload_size;
+  // Untimed frames are silence the player inserts. They have no playtime.
+  int timed = (sample_type == play_samples_are_timed) && (playtime != 0);
+  int rc = 0;
+  int oldState;
+  // A record cut short by cancellation would desync the reader, so the lock is never held at a
+  // cancellation point. The write below can therefore block uncancellably while the pipe is
+  // full. The reader must always drain it, from start-up and independent of any play session.
+  // A stalled reader holds up session teardown only until it reads again; a reader that is gone
+  // makes write() fail with EPIPE (SIGPIPE is ignored).
+  pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &oldState);
+  pthread_mutex_lock(&record_lock);
+  if (fd == -1)
+    fd = try_to_open_pipe_for_writing(pipename);
+  write_pending_markers(0); // markers belong before this record
   if (fd > 0) {
-    // int rc = non_blocking_write(fd, buf, samples * 4);
-    if (bytes_per_frame == 0)
-      debug(1, "pipe: bytes per frame not initialised before play()!");
-    int rc = write(fd, buf, samples * bytes_per_frame);
-    if ((rc < 0) && (errno != EPIPE) && (warned == 0)) {
-      strerror_r(errno, (char *)errorstring, 1024);
-      debug(1, "error %d writing to the pipe named \"%s\": \"%s\".", errno, pipename, errorstring);
-      warned = 1;
+    if (size > record_buf_size) {
+      uint8_t *b = realloc(record_buf, size);
+      if (b == NULL) {
+        rc = -1;
+        errno = ENOMEM;
+        goto out;
+      }
+      record_buf = b;
+      record_buf_size = size;
+    }
+    put_header(record_buf, timed ? TIMING_FLAG_TIMED : 0, frames, timestamp, timed ? playtime : 0);
+    if (payload_size)
+      memcpy(record_buf + TIMING_HEADER_SIZE, payload, payload_size);
+    rc = write_fully(record_buf, size);
+  }
+out:
+  pthread_mutex_unlock(&record_lock);
+  pthread_setcancelstate(oldState, NULL);
+  return rc;
+}
+
+static void write_marker(uint16_t flags) {
+  if (timing_headers == 0)
+    return;
+  pthread_mutex_lock(&pending_lock);
+  pending_markers |= flags;
+  pthread_mutex_unlock(&pending_lock);
+  int oldState;
+  pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &oldState);
+  // if a record is being written, the next record writes the marker
+  if (pthread_mutex_trylock(&record_lock) == 0) {
+    write_pending_markers(1);
+    pthread_mutex_unlock(&record_lock);
+  }
+  pthread_setcancelstate(oldState, NULL);
+}
+
+static int play(void *buf, int samples, int sample_type, uint32_t timestamp, uint64_t playtime) {
+  char errorstring[1024];
+  if (bytes_per_frame == 0)
+    debug(1, "pipe: bytes per frame not initialised before play()!");
+  int rc = 0;
+  if (timing_headers) {
+    rc = write_record(buf, samples, sample_type, timestamp, playtime);
+  } else {
+    // if the file is not open, try to open it.
+    if (fd == -1) {
+      fd = try_to_open_pipe_for_writing(pipename);
+    }
+    // if it's got a reader, write to it.
+    if (fd > 0) {
+      // int rc = non_blocking_write(fd, buf, samples * 4);
+      rc = write(fd, buf, samples * bytes_per_frame);
     }
   }
+  if ((rc < 0) && (errno != EPIPE) && (warned == 0)) {
+    strerror_r(errno, (char *)errorstring, 1024);
+    debug(1, "error %d writing to the pipe named \"%s\": \"%s\".", errno, pipename, errorstring);
+    warned = 1;
+  }
   return 0;
 }

 static void stop(void) {
   // Don't close the pipe just because a play session has stopped.
+  write_marker(TIMING_FLAG_STOP);
 }

+static void flush(void) { write_marker(TIMING_FLAG_FLUSH); }
+
 static int init(int argc, char **argv) {
   //  debug(1, "pipe init");
   //  const char *str;
@@ -124,6 +283,7 @@ static int init(int argc, char **argv) {
     } else {
       die("pipename needed");
     }
+    config_set_lookup_bool(config.cfg, "pipe.timing_headers", &timing_headers);
   }

   if (argc > 1)
@@ -144,12 +304,18 @@ static int init(int argc, char **argv) {
     die("Could not create audio pipe \"%s\"", pipename);
   umask(oldumask);

-  debug(1, "audio pipe name is \"%s\"", pipename);
+  debug(1, "audio pipe name is \"%s\"%s", pipename,
+        timing_headers ? ", with timing headers" : "");

   return 0;
 }

-static void deinit(void) { safe_socket_close(&fd); }
+static void deinit(void) {
+  safe_socket_close(&fd);
+  free(record_buf);
+  record_buf = NULL;
+  record_buf_size = 0;
+}

 static void help(void) {
   printf("    Provide the pipe's pathname. The default is \"%s\".\n", default_pipe_name);
@@ -172,6 +338,7 @@ static int configure(int32_t requested_encoded_format, __attribute__((unused)) c
     response = EINVAL;
   }
   bytes_per_frame = bytes_per_sample * CHANNELS_FROM_ENCODED_FORMAT(requested_encoded_format);
+  output_rate = RATE_FROM_ENCODED_FORMAT(requested_encoded_format);
   return response;
 }

@@ -184,7 +351,7 @@ audio_output audio_pipe = {.name = "pipe",
                            .configure = &configure,
                            .stop = &stop,
                            .is_running = NULL,
-                           .flush = NULL,
+                           .flush = &flush,
                            .delay = NULL,
                            .stats = NULL,
                            .play = &play,
diff --git a/scripts/shairport-sync.conf b/scripts/shairport-sync.conf
index 00620f4..582b618 100644
--- a/scripts/shairport-sync.conf
+++ b/scripts/shairport-sync.conf
@@ -265,6 +265,7 @@ pipe =
 //	output_rate = <rate>; // Specify a single rate, e.g. 44100, or a bracketed comma-separated list of rates, e.g. (44100, 48000, 64000) or "auto" -- try to match the input. Default is 44100 for classic AirPlay, 48000 for AirPlay 2. See the "Rates, Formats and Channels" discussion above.
 //	output_format = <format>; // Specify a format, e.g. "S16_LE", or a bracketed comma-separated list of formats, e.g. ("S32_LE", "S16_LE") or "auto". Default is "S16_LE" for classic AirPlay, "S32_LE" for AirPlay 2. See the "Rates, Formats and Channels" discussion above.
 //	output_channels = 2; // Specify a specific number of channels, e.g. 2, or a bracketed comma-separated list of numbers of channels, e.g. (2, 6) or "auto" -- try to match the input. Default is 2. See the "Rates, Formats and Channels" discussion above.
+//	timing_headers = "no"; // Set to "yes" to put a 32-byte header before every block of audio, giving its RTP timestamp and the time at which its first frame should be played, plus header-only records on flush and stop. For readers that schedule the audio themselves. The time, in nanoseconds, is based on the CLOCK_MONOTONIC_RAW of the machine -- if available -- or CLOCK_MONOTONIC otherwise (the monotonic clock on macOS). The header is little-endian: the magic 0x48545053, a 16-bit version (1), 16-bit flags (1 = timed, 2 = flush, 4 = stop), the 32-bit number of frames that follow, the 32-bit RTP timestamp, the 64-bit time (0 if not timed), the 32-bit output rate and the 32-bit bytes per frame.
 };

 // Parameters for the "stdout" audio back end, a back end that directs raw PCM audio output to STDOUT. No interpolation is done.
